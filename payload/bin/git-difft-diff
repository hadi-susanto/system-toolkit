#!/usr/bin/env bash
set -euo pipefail

if [[ -z "${NO_COLOR:-}" ]] &&
    { [[ -n "${FORCE_COLOR:-}" ]] || [[ -t 1 ]]; }; then
    readonly COLOR_RED=$'\033[0;31m'
    readonly COLOR_CYAN=$'\033[0;36m'
    readonly COLOR_RESET=$'\033[0m'
    readonly DFT_COLOR_MODE="always"
else
    readonly COLOR_RED=""
    readonly COLOR_CYAN=""
    readonly COLOR_RESET=""
    readonly DFT_COLOR_MODE="never"
fi

__log_error() {
    printf '%s[ERROR]%s %s\n' \
        "$COLOR_RED" \
        "$COLOR_RESET" \
        "$*" >&2
}

__usage() {
    cat <<EOF
${COLOR_CYAN}Usage:${COLOR_RESET}
  git-difft-diff [OPTIONS] [GIT_DIFF_ARGS...]

Display Git differences using Difftastic.

Arguments not recognized as git-difft-diff options are forwarded directly
to git diff.

${COLOR_CYAN}Options:${COLOR_RESET}
  --dark          Use Difftastic's dark background mode
  --inline        Display differences inline instead of side by side
  -h, --help      Display this help message
  --              Stop parsing git-difft-diff options

${COLOR_CYAN}Examples:${COLOR_RESET}
  git-difft-diff
  git-difft-diff --dark --inline
  git-difft-diff --staged
  git-difft-diff --dark HEAD~1
  git-difft-diff main..feature
  git-difft-diff -- src/main.sh
EOF
}

__parse_args() {
    local options_name="$1"
    local diff_args_name="$2"
    shift 2

    local -n options_ref="$options_name"
    local -n diff_args_ref="$diff_args_name"

    options_ref=(
        [DARK]=0
        [INLINE]=0
    )
    diff_args_ref=()

    while (($# > 0)); do
        case "$1" in
            --dark)
                options_ref[DARK]=1
                ;;

            --inline)
                options_ref[INLINE]=1
                ;;

            -h | --help)
                __usage

                exit 0
                ;;

            --)
                shift
                diff_args_ref+=("--" "$@")

                return 0
                ;;

            *)
                diff_args_ref+=("$1")
                ;;
        esac

        shift
    done
}

main() {
    local -A options=()
    local -a diff_args=()

    __parse_args options diff_args "$@"

    if ! command -v git >/dev/null 2>&1; then
        __log_error "git is not installed or is not available in PATH."

        return 1
    fi

    if ! command -v difft >/dev/null 2>&1; then
        __log_error "difft is not installed or is not available in PATH."

        return 1
    fi

    if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        __log_error "The current directory is not inside a Git repository."

        return 1
    fi

    export DFT_COLOR="$DFT_COLOR_MODE"

    if ((options[DARK])); then
        export DFT_BACKGROUND=dark
    fi

    if ((options[INLINE])); then
        export DFT_DISPLAY=inline
    fi

    exec git \
        -c diff.external=difft \
        diff "${diff_args[@]}"
}

main "$@"
